# 이 파일을 복사해 같은 폴더에 .env 로 저장하고 값을 채운다. (.env는 Git에 올리지 않음)
DJANGO_SECRET_KEY=여기에-임의의-긴-문자열
DJANGO_DEBUG=True

# PostgreSQL 접속 정보
DB_NAME=itb2026
DB_USER=postgres
DB_PASSWORD=여기에-DB-비밀번호
DB_HOST=localhost
DB_PORT=5432

# 가상 계정(seed_users) 공통 비밀번호 — 개발·시연용
SEED_USER_PASSWORD=여기에-시연용-비밀번호

# 경영지원 AI 분석 코멘트 (외부 AI = Claude API). 키가 없으면 [분석하기]가 "키 없음" 안내를 보여 줌
ANTHROPIC_API_KEY=
# 대표님 허락 전에는 False — 배포 서버·엑셀 이관 데이터 분기는 관리자(대표)만 확인창을 거쳐 분석
AI_ALLOW_REAL_DATA=False
# 개발용 모의 응답 (true: 정해진 문장 / fail: 실패 연습) — DJANGO_DEBUG=True 일 때만
AI_MOCK=
